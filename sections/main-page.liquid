{{ 'section-main-page.css' | asset_url | stylesheet_tag }}
{% comment %}theme-check-disable UnclosedHTMLElement{% endcomment %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% if page.handle == 'our-story' %}
  <section class="main--about--container">
    <header class="main--about--imageContainer">
      <img
        src="https://cdn.shopify.com/s/files/1/0051/3264/8566/files/IMG_1248_Facetune_21-08-2022-19-55-54_copy.webp?v=1716319263"
        alt="A photo representing the story behind the brand"
        loading="lazy"
        width="2367"
        height="3247"
        class="main--about--image"
      >
    </header>
{% endif %}

{% if page.handle == 'contact-us' or page.handle == 'sizing' %}
  <div class="page-width main--contact--container page-width--narrow section-{{ section.id }}-padding">
{% else %}
  <div class="page-width page-width--narrow section-{{ section.id }}-padding">
{% endif %}

<h1 class="main-page-title page-title h0{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
  {{ page.title | escape }}
</h1>

{% if page.handle == 'our-story' %}
  <div class="main--about--titleWrapper">
    <h2 class="main--about--title">ABOUT</h2>
    <img
      src="https://cdn.shopify.com/s/files/1/0051/3264/8566/files/script-logo_5.png?v=1715860127"
      alt="The logo for our story text"
      loading="lazy"
      width="1729"
      height="493"
      class="main--about--titleImage"
    >
  </div>
{% endif %}

<div class="rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
  {{ page.content }}
</div>

{% if page.handle == 'our-story' %}
  </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
