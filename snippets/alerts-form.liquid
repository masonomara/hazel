{%- comment -%}
  snippets/alerts-form.liquid
  Shared "Never miss a drop" signup form (email + optional SMS), rendered
  server-side in BOTH the popup (snippets/alerts-signup.liquid) and the footer
  (sections/footer.liquid). Accepts id_prefix (required, unique per render) so
  each control gets a unique id for its <label for>. Behavior (submit, SMS consent reveal) is wired by
  the script in alerts-signup.liquid, which finds every .alerts-form on the page.
{%- endcomment -%}
{%- liquid
  assign mc_honeypot = 'b_bb68751aca24eb8005a87da31_7488b9bad0'
  assign uid = id_prefix | default: 'alerts-form'
  assign privacy_url = shop.privacy_policy.url | default: '/policies/privacy-policy'
-%}
<form class="alerts-form" novalidate>
  <div class="alerts-form__field field">
    <label class="visually-hidden" for="{{ uid }}-email">Email</label>
    <input
      class="field__input"
      id="{{ uid }}-email"
      type="email"
      name="EMAIL"
      autocomplete="email"
      autocapitalize="off"
      autocorrect="off"
      placeholder="Email"
      required
      aria-required="true"
    >
  </div>

  <div class="alerts-form__field field">
    <label class="visually-hidden" for="{{ uid }}-phone">Mobile number (optional)</label>
    <input
      class="field__input"
      id="{{ uid }}-phone"
      type="tel"
      name="SMSPHONE"
      inputmode="tel"
      autocomplete="tel"
      placeholder="Mobile number (optional)"
    >
  </div>

  <label class="alerts-form__consent" data-alerts-consent for="{{ uid }}-sms-ack" hidden>
    <input
      id="{{ uid }}-sms-ack"
      type="checkbox"
      name="mc-SMSPHONE-ack"
      value="true"
    >
    <span class="alerts-form__consent-text" style="text-align: left">
      By providing your phone number and checking the box, you agree to receive recurring
      promotional and marketing text messages (e.g. cart reminders) from Hazel Boutique at the
      number provided. Consent is not a condition of purchase. Msg &amp; data rates may apply.
      Msg frequency varies. Reply HELP for help, STOP to cancel.
      <a href="http://eepurl.com/iwthPw" target="_blank" rel="noopener noreferrer">See terms</a>,
      <a href="{{ privacy_url }}" target="_blank" rel="noopener noreferrer">See privacy policy</a>.
    </span>
  </label>

  {%- comment -%} Honeypot: real users never see or fill this. Name is the b_<u>_<id> value. {%- endcomment -%}
  <div class="alerts-form__hp" aria-hidden="true">
    <label for="{{ uid }}-hp">Leave this field empty</label>
    <input type="text" id="{{ uid }}-hp" name="{{ mc_honeypot }}" tabindex="-1" autocomplete="off" value="" aria-hidden="true">
  </div>

  <button type="submit" class="alerts-form__submit button button--full-width button--primary">Sign Up</button>
  <p class="alerts-form__msg form__message" role="status" aria-live="polite"></p>
</form>
