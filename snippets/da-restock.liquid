{% comment %}theme-check-disable OrphanedSnippet{% endcomment %}
{% assign always_show = shop.metafields['da-restock'].alwaysShow %}
{% assign display_form = product.metafields['da-restock'].hide %}
{% assign preorder = shop.metafields['da-restock'].preorder %}

{% assign back_in_stock_date_text = shop.metafields['da-restock'].showBackInStockDateText %}
{% assign back_in_stock_date_format = shop.metafields['da-restock'].showBackInStockDateFormat %}
{% assign back_in_stock_date = product.metafields['da-restock'].backInStockDate %}

{% assign prefill_email = '' %}
{% if shop.metafields['da-restock'].prefillEmail == 'true' and customer.email %}
  {% assign prefill_email = customer.email %}
{% endif %}
<script type="text/javascript">
  const da_variant = {{ product.selected_or_first_available_variant.id }};
</script>

{% comment %}theme-check-disable RemoteAsset{% endcomment %}
<script type="text/JavaScript" src="https://MomentJS.com/downloads/moment.js" defer></script>
{% comment %}theme-check-enable RemoteAsset{% endcomment %}
<script type="text/JavaScript">
  const date = moment("{{ back_in_stock_date }}").format("{{ back_in_stock_date_format }}");
  const backInStockDateText = "{{ back_in_stock_date_text }}"
  {% raw %}
    const updatedBackInStockDateText = (backInStockDateText).replace("{{ date }}", date).replace("{{ date }}", date);
  {% endraw %}
</script>

{% comment %} Do not show form for ignored collections {% endcomment %}
{% for collection in product.collections %}
  {% if collection.metafields['da-restock'].forbidden == 'true' %}
    {% assign display_form = 'false' %}
  {% endif %}
{% endfor %}

{% if always_show == 'true' and display_form != 'false' %}
  {% assign show = false %}
  {% assign multiple_variants = false %}
  {% if product.variants.size > 1 %}
    {% assign multiple_variants = true %}
  {% endif %}
  {% for variant in product.variants %}
    {% if preorder == 'true' %}
      {% unless variant.inventory_quantity > 0 %}
        {% assign show = true %}
      {% endunless %}
    {% else %}
      {% unless variant.available %}
        {% assign show = true %}
      {% endunless %}
    {% endif %}
  {% endfor %}
  {% if show %}
    <div class="dd-restock-notification-container-v2" id="dd-restock-notification-container">
      <div id="dd-restock-notification-msg">
        <div id="dd-restock-notification-msg-success" style="display: none">
          {{ shop.metafields['da-restock'].success }}
        </div>
        <div id="dd-restock-notification-msg-error" style="display: none">
          {{ shop.metafields['da-restock'].error }}
        </div>
      </div>
      <div class="da-restock-notification da-restock-alwaysShow">
        <div class="da-restock-notification-form">
          <p>{{ shop.metafields['da-restock'].productText }}</p>
          {% if back_in_stock_date and back_in_stock_date_text %}
            <div id="daBackInStockDate{{product.id}}" />
            <script type="text/JavaScript">
              document.querySelector('#daBackInStockDate{{ product.id }}').innerHTML = updatedBackInStockDateText;
            </script>
          {% endif %}

          {% if multiple_variants %}
            <select name="variant">
              {% for variant in product.variants %}
                {% if preorder == 'true' %}
                  {% unless variant.inventory_quantity > 0 %}
                    <option value="{{ variant.id }}">{{ variant.title }}</option>
                  {% endunless %}
                {% else %}
                  {% unless variant.available %}
                    <option value="{{ variant.id }}">{{ variant.title }}</option>
                  {% endunless %}
                {% endif %}
              {% endfor %}
            </select>
          {% else %}
            <input
              type="hidden"
              name="davariant"
              value="{{ product.variants[0].id }}"
            >
          {% endif %}
          <input
            type="text"
            placeholder="{{ shop.metafields.da-restock.productInput | escape }}"
            name="email"
            value="{{prefill_email}}"
          >
          <input
            type="hidden"
            name="store"
            value="{{ shop.permanent_domain }}"
          >
          <input
            type="hidden"
            name="product"
            value="{{ product.id }}"
          >
          <input
            type="hidden"
            name="url"
            value="{{ product.url }}"
          >
          <div class="btn da-restock-notification-button">{{ shop.metafields['da-restock'].productButton }}</div>
          {% if shop.metafields['da-restock'].marketingCheckboxText %}
            <div class="da-restock-checkbox-group">
              <label for="da-restock-variant-{{variant.id}}-acceptsMarketing">
                <input
                  id="da-restock-variant-{{variant.id}}-acceptsMarketing"
                  type="checkbox"
                  value="acceptsMarketing"
                  name="daAcceptsMarketing"
                  checked
                >
                {{- shop.metafields['da-restock'].marketingCheckboxText }}
              </label>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  {% endif %}
{% elsif display_form != 'false' %}
  <div class="dd-restock-notification-container-v2" id="dd-restock-notification-container">
    <div id="dd-restock-notification-msg">
      <div id="dd-restock-notification-msg-success" style="display: none">
        {{ shop.metafields['da-restock'].success }}
      </div>
      <div id="dd-restock-notification-msg-error" style="display: none">{{ shop.metafields['da-restock'].error }}</div>
    </div>
    {% for variant in product.variants %}
      {% assign variant_available = variant.available %}
      {% if preorder == 'true' %}
        {% if variant.inventory_quantity > 0 %}
          {% assign variant_available = true %}
        {% else %}
          {% assign variant_available = false %}
        {% endif %}
      {% endif %}
      {% unless variant_available %}
        <div
          class="da-restock-notification"
          id="da-restock-notification-variant-{{ variant.id }}"
          style="display:none"
        >
          <div class="da-restock-notification-form">
            <p>{{ shop.metafields['da-restock'].productText }}</p>

            {% if back_in_stock_date and back_in_stock_date_text %}
              <div id="daBackInStockDate{{product.id}}{{variant.id}}"></div>
              <script type="text/javascript">
                document.querySelector('#daBackInStockDate{{ product.id }}{{ variant.id }}').innerHTML =
                  updatedBackInStockDateText;
              </script>
            {% endif %}
            <input
              type="text"
              placeholder="{{ shop.metafields.da-restock.productInput | escape }}"
              name="email"
              value="{{prefill_email}}"
            >
            <input
              type="hidden"
              name="store"
              value="{{ shop.permanent_domain }}"
            >
            <input
              type="hidden"
              name="product"
              value="{{ product.id }}"
            >
            <input
              type="hidden"
              name="url"
              value="{{ product.url }}"
            >
            <input
              type="hidden"
              id="da-restock-variant"
              name="davariant"
              value="{{ variant.id }}"
            >
            <div class="btn da-restock-notification-button">{{ shop.metafields['da-restock'].productButton }}</div>
            {% if shop.metafields['da-restock'].marketingCheckboxText %}
              <div class="da-restock-checkbox-group">
                <label for="da-restock-variant-{{variant.id}}-acceptsMarketing">
                  <input
                    id="da-restock-variant-{{variant.id}}-acceptsMarketing"
                    type="checkbox"
                    value="acceptsMarketing"
                    name="daAcceptsMarketing"
                    checked
                  >
                  {{- shop.metafields['da-restock'].marketingCheckboxText }}
                </label>
              </div>
            {% endif %}
          </div>
        </div>
      {% endunless %}
    {% endfor %}
  </div>
{% endif %}
